          <mxGeometry x="1363" y="1019" width="274" height="28" as="geometry" />
        </mxCell>
        <mxCell id="TX_NOTE1" value="Important: FAILED and EXPIRED must NEVER issue a ticket.&lt;br/&gt;EXPIRED is not terminal: a late verified SUCCESS is recorded as PAID_UNFULFILLED.&lt;br/&gt;A separate fresh PurchaseTransaction is used for an allowed retry." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFBEA;strokeColor=#D0AF5D;strokeWidth=1.2;fontColor=#594C26;fontFamily=Arial;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="75" y="870" width="435" height="175" as="geometry" />
        </mxCell>
        <mxCell id="TX_NOTE2" value="The QR validity timer (120 s) starts when the QR is generated.&lt;br/&gt;The payment-result timeout (30 s) starts only after submission.&lt;br/&gt;PENDING and CANCEL_PENDING require reconciliation, not immediate retry." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFBEA;strokeColor=#D0AF5D;strokeWidth=1.2;fontColor=#594C26;fontFamily=Arial;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="66" y="1125" width="468" height="162" as="geometry" />
        </mxCell>
        <mxCell id="TX_NOTE3" value="Safety invariant:&lt;br/&gt;Issue ticket only after CONFIRMED and verification of signature, transaction ID, amount and idempotency.&lt;br/&gt;No second ticket for duplicate success." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFBEA;strokeColor=#D0AF5D;strokeWidth=1.2;fontColor=#594C26;fontFamily=Arial;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1800" y="1150" width="527" height="145" as="geometry" />
        </mxCell>
        <mxCell id="FOOTER" value="One PurchaseTransaction = one payment attempt. The new retry creates another PurchaseTransaction for the same PurchaseSession; a transaction never loops from FAILED back to CREATED." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=13;fontColor=#536681;" vertex="1" parent="1">
          <mxGeometry x="70" y="1445" width="2310" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
