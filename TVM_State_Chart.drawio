        <mxCell id="NOTE_1" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFBEA;strokeColor=#D0AF5D;strokeWidth=1.2;fontColor=#594C26;fontFamily=Arial;fontSize=14;spacing=12;" value="State scope: TVM purchase workflow (not a PurchaseTransaction enum).&lt;br/&gt;60-second idle cancellation only when safe, before a payment is confirmed.&lt;br/&gt;No retries while a result remains PENDING or CANCEL_PENDING." vertex="1">
