        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml TVM_Use_Case_Diagram\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\nactor Passenger\nactor \&quot;Payment Gateway\&quot; as PG\nactor \&quot;Maintenance Team\&quot; as MT\n\nrectangle \&quot;Smart Ticketing System (TVM)\&quot; {\n  usecase \&quot;UC01\\nStart Purchase\&quot; as UC01\n  usecase \&quot;UC02\\nBrowse Routes\&quot; as UC02\n  usecase \&quot;UC03\\nSelect Route and\\nReview Fare\&quot; as UC03\n  usecase \&quot;UC04\\nChoose Payment Method\&quot; as UC04\n  usecase \&quot;UC05\\nPay by Card\&quot; as UC05\n  usecase \&quot;UC06\\nPay by QR Code or\\nDigital Wallet\&quot; as UC06\n  usecase \&quot;UC07\\nConfirm Payment\&quot; as UC07\n  usecase \&quot;UC08\\nHandle Payment Failure\&quot; as UC08\n  usecase \&quot;UC09\\nCancel Purchase\&quot; as UC09\n  usecase \&quot;UC10\\nIssue Ticket\&quot; as UC10\n  usecase \&quot;UC11\\nHandle Printer Failure\&quot; as UC11\n  usecase \&quot;UC12\\nHandle Network\\nUnavailability\&quot; as UC12\n}\n\n&#39; Passenger associations\nPassenger -- UC01\nPassenger -- UC02\nPassenger -- UC03\nPassenger -- UC04\nPassenger -- UC05\nPassenger -- UC06\nPassenger -- UC08\nPassenger -- UC09\nPassenger -- UC10\nPassenger -- UC11\nPassenger -- UC12\n\n&#39; Payment Gateway associations\nPG -- UC05\nPG -- UC06\nPG -- UC07\nPG -- UC12\n\n&#39; Maintenance notification (FR-22)\nMT -- UC11\n\n&#39; Include relationships\nUC01 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC05 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\nUC07 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n\n&#39; Extend relationships\nUC05 ..&gt; UC04 : &lt;&lt;extend&gt;&gt;\\n[Card selected]\nUC06 ..&gt; UC04 : &lt;&lt;extend&gt;&gt;\\n[QR / wallet selected]\nUC08 ..&gt; UC07 : &lt;&lt;extend&gt;&gt;\\n[Payment declined / failed]\nUC09 ..&gt; UC03 : &lt;&lt;extend&gt;&gt;\\n[Before payment confirmation]\nUC09 ..&gt; UC04 : &lt;&lt;extend&gt;&gt;\\n[Before payment confirmation]\nUC11 ..&gt; UC10 : &lt;&lt;extend&gt;&gt;\\n[Printer failure]\nUC12 ..&gt; UC07 : &lt;&lt;extend&gt;&gt;\\n[Network unavailable]\n\nnote right of UC07\n  UC07 includes UC10 as recorded\n  in the workbook.\n\n  UC10 is executed only after a\n  verified SUCCESS result and\n  transaction status CONFIRMED.\n\n  FAILED, EXPIRED and PENDING\n  do not issue a ticket.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Rj3RFpaM5zFV0vV-vPjg-363">
