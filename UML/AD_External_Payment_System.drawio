        <UserObject label="Payment integration rules:&#xa;- QR validity: 120 seconds from generation.&#xa;- QR polling: every 2 seconds.&#xa;- Callback and polling are alternative&#xa;  methods of receiving the same result.&#xa;- No final result after 30 seconds:&#xa;  PENDING / RECONCILIATION.&#xa;- A timeout is not a DECLINED result.&#xa;- Invalid signature, transaction ID or amount:&#xa;  reject and log the event.&#xa;- Duplicate confirmations cannot create&#xa;  a second ticket.&#xa;- Late SUCCESS after QR expiry is recorded&#xa;  for reconciliation only; no ticket is issued.&#xa;- Network recovery: synchronize records&#xa;  within 5 minutes and resume sales." plantUmlId="note_345" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;" plantUmlBaseValue="Payment integration rules:&#xa;- QR validity: 120 seconds from generation.&#xa;- QR polling: every 2 seconds.&#xa;- Callback and polling are alternative&#xa;  methods of receiving the same result.&#xa;- No final result after 30 seconds:&#xa;  PENDING / RECONCILIATION.&#xa;- A timeout is not a DECLINED result.&#xa;- Invalid signature, transaction ID or amount:&#xa;  reject and log the event.&#xa;- Duplicate confirmations cannot create&#xa;  a second ticket.&#xa;- Late SUCCESS after QR expiry is recorded&#xa;  for reconciliation only; no ticket is issued.&#xa;- Network recovery: synchronize records&#xa;  within 5 minutes and resume sales." id="Rj3RFpaM5zFV0vV-vPjg-877">
          <mxCell parent="Rj3RFpaM5zFV0vV-vPjg-638" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;" vertex="1">
            <mxGeometry height="255" width="308" x="604" y="4006" as="geometry" />
          </mxCell>
        </UserObject>
