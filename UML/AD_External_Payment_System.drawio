<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="6Sqa8mYcHIUhaKSa0shD">
    <mxGraphModel dx="2470" dy="1430" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml TVM_Activity_Payment_Gateway\ntitle Activity Diagram - TVM Payment Gateway Integration\nskinparam shadowing false\n\nstart\n\n|TVM|\n:Receive payment request from UC04;\n:Create unique transaction ID;\n:Record amount, time, route and payment method;\n:Set transaction status to CREATED;\n\nif (Selected payment method?) then (Credit Card)\n\n  |Passenger|\n  :Insert or tap credit card;\n\n  |TVM|\n  :Read simulated card event;\n\n  if (Chip card requires PIN?) then (Yes)\n    |Passenger|\n    :Enter PIN;\n    |TVM|\n  else (No)\n  endif\n\n  :Build authorization request;\n  :Send transaction ID and amount\n  to Payment Gateway via TLS;\n\n  note right\n    Card details, PIN and CVV\n    must not be stored by the TVM.\n    Card flow is simulated in the prototype.\n  end note\n\n  |Payment Gateway|\n  :Process card authorization;\n  :Return APPROVED or DECLINED;\n\n  |TVM|\n  :Receive authorization response;\n  :Verify trusted response, transaction ID and amount;\n\nelse (QR / Digital Wallet)\n\n  |TVM|\n  :Send QR creation request with\n  transaction ID, amount and provider;\n\n  |Payment Gateway|\n  :Generate transaction-specific QR;\n  :Set QR expiry to 120 seconds after generation;\n  :Return QR payload and expiry time;\n\n  |TVM|\n  :Display QR code;\n  :Start 120-second QR validity timer;\n\n  |Passenger|\n  :Scan QR using bank / wallet app;\n  :Confirm payment;\n\n  |Payment Gateway|\n  :Process payment;\n  :Prepare signed payment callback;\n\n  |TVM|\n  :Start 30-second final-result waiting window;\n\n  note right\n    The 30-second timer starts when\n    payment is started / submitted.\n    It is separate from the QR&#39;s\n    120-second validity timer.\n  end note\n\n  repeat\n\n    if (Signed callback received?) then (Yes)\n\n      |TVM|\n      :Receive callback;\n      :Verify callback signature;\n      :Verify transaction ID and amount;\n\n    else (No)\n\n      |TVM|\n      :Wait for next polling interval;\n      :Poll payment status every 2 seconds;\n\n      |Payment Gateway|\n      :Return current transaction status;\n\n      |TVM|\n      :Receive polling response;\n      :Verify trusted response,\n      transaction ID and amount;\n\n    endif\n\n    if (Verification successful?) then (Yes)\n      :Capture verified payment result;\n    else (No)\n      :Reject invalid result;\n      :Log security event;\n    endif\n\n  repeat while (No verified final result and\n  30-second window is open and QR is valid?) is (Yes)\n\nendif\n\n|TVM|\nif (Network unavailable during payment?) then (Yes)\n\n  :Trigger UC12 Handle Network Unavailability;\n  :Detect network loss within 10 seconds;\n  :Disable new purchases;\n  :Display \&quot;Payment service unavailable\&quot;;\n  :Store transaction records locally;\n  :Set in-progress payment to PENDING;\n\n  note right\n    No offline sales are allowed.\n    Buffer at least 1,000 records.\n  end note\n\n  repeat\n    :Wait for network recovery;\n  repeat while (Network still unavailable?) is (Yes)\n\n  :Reconnect to Payment Gateway;\n  :Send status inquiry using the same transaction ID;\n\n  |Payment Gateway|\n  :Return current transaction status;\n\n  |TVM|\n  :Verify returned status,\n  transaction ID and amount;\n\n  if (Verified final status returned?) then (Yes)\n    :Capture verified final result;\n  else (No)\n    :Keep transaction PENDING;\n    :Repeat status inquiry until final status is known;\n  endif\n\n  :Synchronize stored records within 5 minutes;\n  :Resume new sales after service restoration;\n\nelse (No)\n  :Continue payment-result handling;\nendif\n\nif (No final result within 30 seconds?) then (Yes)\n\n  :Set transaction to PENDING / RECONCILIATION;\n  :Do not issue a ticket;\n  :Do not allow retry until final status is known;\n  :Send status inquiry to Payment Gateway;\n\n  repeat\n\n    |Payment Gateway|\n    :Return final status if available;\n\n    |TVM|\n    :Verify transaction ID and amount;\n\n    if (Valid final status received?) then (Yes)\n      :Capture final result;\n    else (No)\n      :Keep transaction PENDING;\n      :Repeat status inquiry;\n    endif\n\n  repeat while (Final status still unknown?) is (Yes)\n\nelse (Final result received)\n  :Continue with verified final result;\nendif\n\n|TVM|\nif (Duplicate transaction result?) then (Yes)\n\n  :Ignore duplicate result;\n  :Do not create another ticket;\n  stop\n\nelse (No)\n\n  if (QR payment and QR expired before success?) then (Yes)\n\n    :Set current QR attempt to EXPIRED;\n    :Record any late SUCCESS for reconciliation;\n    :Do not issue a ticket for the expired QR attempt;\n    :Trigger UC08 Handle Payment Failure;\n    stop\n\n  else (No)\n\n    if (Gateway result is APPROVED / SUCCESS?) then (Yes)\n\n      :Set transaction status to CONFIRMED;\n      :Record payment idempotently;\n\n      if (Passenger still at the TVM?) then (Yes)\n        :Trigger UC10 Issue Ticket exactly once;\n      else (No)\n        :Set transaction to PAID_UNFULFILLED;\n        :Generate support reference;\n      endif\n\n      stop\n\n    else (DECLINED / FAILED / EXPIRED)\n\n      :Set transaction status to FAILED or EXPIRED;\n      :Issue no ticket;\n      :Trigger UC08 Handle Payment Failure;\n\n      note right\n        UC08 allows one fresh payment attempt\n        with a new transaction ID, or cancellation.\n        A second failure allows cancellation only.\n      end note\n\n      stop\n\n    endif\n  endif\nendif\n\nnote right\n  Payment integration rules:\n  - QR validity: 120 seconds from generation.\n  - QR polling: every 2 seconds.\n  - Callback and polling are alternative\n    methods of receiving the same result.\n  - No final result after 30 seconds:\n    PENDING / RECONCILIATION.\n  - A timeout is not a DECLINED result.\n  - Invalid signature, transaction ID or amount:\n    reject and log the event.\n  - Duplicate confirmations cannot create\n    a second ticket.\n  - Late SUCCESS after QR expiry is recorded\n    for reconciliation only; no ticket is issued.\n  - Network recovery: synchronize records\n    within 5 minutes and resume sales.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Rj3RFpaM5zFV0vV-vPjg-638">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
