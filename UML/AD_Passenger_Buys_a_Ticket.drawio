        <UserObject label="Business rules:&#xa;- One confirmed payment produces exactly one ticket.&#xa;- A confirmed payment cannot be silently cancelled.&#xa;- A pending transaction cannot be retried.&#xa;- Before payment initiation, 60 seconds without input&#xa;  resets the session to Welcome.&#xa;- Print failure is recorded as PAID_UNFULFILLED.&#xa;- The TVM does not automatically refund." plantUmlId="note_339" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;" plantUmlBaseValue="Business rules:&#xa;- One confirmed payment produces exactly one ticket.&#xa;- A confirmed payment cannot be silently cancelled.&#xa;- A pending transaction cannot be retried.&#xa;- Before payment initiation, 60 seconds without input&#xa;  resets the session to Welcome.&#xa;- Print failure is recorded as PAID_UNFULFILLED.&#xa;- The TVM does not automatically refund." id="Rj3RFpaM5zFV0vV-vPjg-636">
          <mxCell parent="Rj3RFpaM5zFV0vV-vPjg-412" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;shadow=0;" vertex="1">
