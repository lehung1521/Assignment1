<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="6Sqa8mYcHIUhaKSa0shD">
    <mxGraphModel dx="2470" dy="1430" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml TVM_Activity_Buy_Ticket\ntitle Activity Diagram - Passenger Buys a Ticket at the TVM\nskinparam shadowing false\n\nstart\n\n|Passenger|\n:Press \&quot;Start\&quot;;\n\n|TVM|\n:Check printer and paper status;\n:Check payment network availability;\n\nif (Printer and network ready?) then (Yes)\n  :Create purchase session with unique session ID;\n  :Start 60-second idle timer;\n  :Display Vietnamese screen by default;\n  :Display transport modes (Bus, MRT);\nelse (No)\n  if (Printer unavailable or no paper?) then (Yes)\n    :Display \&quot;Out of service\&quot;;\n  else (Network unavailable)\n    :Display \&quot;Payment service unavailable\&quot;;\n  endif\n  :Do not create purchase session;\n  stop\nendif\n\n|Passenger|\n:Select transport mode;\n\n|TVM|\n:Display destinations for selected mode;\n\nrepeat\n  |Passenger|\n  :Select destination;\n\n  |TVM|\n  :Load matching routes from fixed origin;\n\n  if (Available route exists?) then (Yes)\n    :Display available routes;\n  else (No)\n    :Display \&quot;No route available\&quot;;\n    :Return to destination list;\n  endif\n\nrepeat while (No available route?) is (Yes)\n\nrepeat\n  |Passenger|\n  :Select one available route;\n\n  |TVM|\n  :Recheck route availability;\n  :Retrieve fare from configured fare table;\n\n  if (Route available and fare found?) then (Yes)\n    :Display ticket details and fare;\n\n    note right\n      Ticket type: Single journey\n      Quantity: 1\n      Fare: VND\n    end note\n\n  else (No)\n    :Display \&quot;This ticket cannot be sold\&quot;;\n    :Return to route list;\n  endif\n\nrepeat while (Route unavailable or fare missing?) is (Yes)\n\n|Passenger|\nif (Confirm fare?) then (Yes)\n  :Confirm ticket details;\nelse (Cancel)\n  |TVM|\n  :Clear selection and session data;\n  :Return to Welcome screen;\n  stop\nendif\n\n|TVM|\n:Initialize freshAttemptUsed = false;\n\nrepeat\n  :Create a unique transaction ID;\n  :Set transaction status to CREATED;\n  :Display payment amount and two payment options;\n\n  |Passenger|\n  :Choose payment method;\n\n  if (Payment method?) then (Credit Card)\n\n    :Insert or tap credit card;\n\n    |TVM|\n    :Read simulated card event;\n    :Request card authorization from Payment Gateway;\n\n  else (QR / Digital Wallet)\n\n    |TVM|\n    :Request transaction-specific QR code;\n\n    |Payment Gateway|\n    :Generate QR code linked to transaction ID;\n    :Set QR validity to 120 seconds;\n\n    |TVM|\n    :Display QR code and countdown;\n\n    |Passenger|\n    :Scan QR using bank / wallet app;\n    :Confirm payment;\n\n    |Payment Gateway|\n    :Process QR payment;\n    :Send payment result to TVM;\n\n  endif\n\n  |TVM|\n  :Wait for trusted final payment result;\n\n  note right\n    - QR validity: 120 seconds from generation.\n    - No final payment result within 30 seconds:\n      set status to PENDING.\n    - See the separate Payment Gateway\n      Activity Diagram for callback, polling\n      and reconciliation.\n  end note\n\n  if (Final result received and verified?) then (Yes)\n\n    if (Payment result is SUCCESS?) then (Yes)\n      :Set transaction status to CONFIRMED;\n      :Record payment idempotently;\n\n    else (DECLINED / FAILED / EXPIRED)\n      :Set transaction status to FAILED or EXPIRED;\n      :Display payment failure reason;\n      :Inform passenger that no ticket was issued;\n\n      if (Fresh attempt already used?) then (Yes)\n        |Passenger|\n        :Only \&quot;Cancel\&quot; is available;\n\n        |TVM|\n        :Clear session and selection;\n        :Return to Welcome screen;\n        stop\n\n      else (No)\n        |Passenger|\n        if (Choose \&quot;Try again\&quot;?) then (Yes)\n          |TVM|\n          :Mark freshAttemptUsed = true;\n          :Create a new transaction in next attempt;\n        else (Cancel)\n          |TVM|\n          :Clear session and selection;\n          :Return to Welcome screen;\n          stop\n        endif\n      endif\n    endif\n\n  else (No final result within 30 seconds)\n\n    :Set transaction to PENDING / RECONCILIATION;\n    :Do not issue a ticket;\n    :Do not allow another payment attempt;\n    :Keep transaction for status inquiry;\n\n    stop\n\n  endif\n\nrepeat while (Fresh attempt requested?) is (Yes)\n\n|TVM|\n:Create unique ticket ID;\n:Build barcode encoding the ticket ID;\n:Prepare ticket details for printing;\n\n|Thermal Printer|\n:Print paper ticket with ticket ID, mode,\norigin, destination, fare, purchase time\nand barcode;\n\nif (Printing successful?) then (Yes)\n\n  |TVM|\n  :Display purchase success screen;\n  :Display \&quot;Please take your ticket\&quot;;\n\n  |Passenger|\n  :Take the ticket;\n\n  |TVM|\n  :Mark transaction as COMPLETED;\n  :Return to Welcome screen;\n\nelse (No)\n\n  |TVM|\n  :Set transaction to PAID_UNFULFILLED;\n  :Generate and display support reference;\n  :Block new sales;\n\n  |Maintenance Team|\n  :Receive printer failure alert;\n\nendif\n\nstop\n\nnote right\n  Business rules:\n  - One confirmed payment produces exactly one ticket.\n  - A confirmed payment cannot be silently cancelled.\n  - A pending transaction cannot be retried.\n  - Before payment initiation, 60 seconds without input\n    resets the session to Welcome.\n  - Print failure is recorded as PAID_UNFULFILLED.\n  - The TVM does not automatically refund.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Rj3RFpaM5zFV0vV-vPjg-412">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
