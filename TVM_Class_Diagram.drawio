        <mxCell id="note_semantics" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF9E9;strokeColor=#CBB782;strokeWidth=1;fontColor=#53452E;fontFamily=Arial;fontSize=17;spacing=18;" value="&lt;b&gt;UML line meanings&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color:#536A80&quot;&gt;━━&lt;/span&gt;  Association (solid, no arrow; multiplicities describe object links)&lt;br/&gt;&lt;span style=&quot;color:#7D6899&quot;&gt;┄┄▷&lt;/span&gt;  Dependency (dashed, open arrow to the used class)&lt;br/&gt;&lt;span style=&quot;color:#7D6899&quot;&gt;┄┄▷&lt;/span&gt;  Realization (dashed, hollow triangle points to interface)&lt;br/&gt;&lt;b&gt;Important&lt;/b&gt;: SQL-backed classes do not imply inheritance or composition automatically." vertex="1">
          <mxGeometry height="270" width="2590" x="4675" y="3500" as="geometry" />
        </mxCell>
        <mxCell id="note_design" parent="1" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF9E9;strokeColor=#CBB782;strokeWidth=1;fontColor=#53452E;fontFamily=Arial;fontSize=16;spacing=16;" value="&lt;b&gt;Model alignment&lt;/b&gt;&lt;br/&gt;14 persistent SQL entities + 12 application/service/interface classes.&lt;br/&gt;No separate Passenger entity: it is the external actor in Use Cases/Sequence.&lt;br/&gt;SecurityEvent.TransactionId has no declared FK; TransactionStatusTransition is a status-rule lookup.&lt;br/&gt;1 additional fresh payment attempt per purchase is a business constraint." vertex="1">
          <mxGeometry height="270" width="2020" x="7550" y="3500" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#5A6A7D;fontSize=17;fontFamily=Arial;" value="SOURCE: 01_create_schema.sql + Use Case Descriptions UC01–UC12 + latest team Class Diagram and Sequence Diagram  |  Service signatures are design-level methods, not verified compiled code." vertex="1">
          <mxGeometry height="50" width="9570" x="140" y="4000" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
